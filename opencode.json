{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": {
      "*": "allow",
      "src/styles/global.css": "ask",
      "src/styles/**": "ask",
      "src/layouts/**": "ask",
      "astro.config.mjs": "ask",
      ".env": "deny"
    },
    "bash": {
      "git *": "ask",
      "git push origin main*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    }
  }
}
